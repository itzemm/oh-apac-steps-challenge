rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Challenge-wide settings (name, start date, weeks, step limit). Admin-only
    // writes; never deletable (there's no legitimate reason to delete this doc —
    // losing it would wipe the configured start date for everyone).
    match /config/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // One profile doc per user, keyed by their Firebase Auth uid. There is no
    // self-service sign-up: every account (and its profile) is provisioned
    // ahead of time by an admin running /scripts locally with the Firebase
    // Admin SDK, which bypasses these rules entirely — so client-side create
    // is simply never allowed.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if false;
      // Users may update their own profile (name/country/mustChangePassword)
      // but never their own role. Admins may change ONLY the role field on
      // any profile.
      allow update: if isSignedIn() && (
        (isSelf(uid) && request.resource.data.role == resource.data.role)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
      );
      allow delete: if false;
    }

    // Teams are provisioned the same way as users (see above) — client-side
    // create is never allowed. Once created, any signed-in participant may
    // update a team (leave/remove-member touch the team doc) without a Cloud
    // Functions backend. Deleting is only ever allowed once a team is already
    // empty (the app clears `members` to [] right before deleting it when the
    // last person leaves) — this stops anyone from deleting an active team
    // full of people.
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.members.size() == 0;
    }

    // Bonus challenges are admin-authored and admin-awarded.
    match /bonus/{bonusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Per-user step logs, keyed by uid. Everyone can read (leaderboard/team
    // views need everyone's totals). The owner can write their own days/proof,
    // but the "verified" audit stamp can only ever be set by an admin — never
    // by the participant themselves, even by calling Firestore directly.
    match /steps/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) && !('verified' in request.resource.data);
      allow update: if isAdmin()
        || (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']));
      allow delete: if false;
    }
  }
}
