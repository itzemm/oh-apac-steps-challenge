rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Challenge-wide settings (name, start date, weeks, step limit). Admin-only
    // writes; never deletable (there's no legitimate reason to delete this doc —
    // losing it would wipe the configured start date for everyone).
    match /config/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // One profile doc per user, keyed by their Firebase Auth uid. There is no
    // self-service sign-up: every account (and its profile) is provisioned
    // ahead of time by an admin, either via /scripts locally or the Admin
    // tab's "Add a participant"/"Bulk import" tools (which create the Auth
    // account client-side, then write this doc while signed in as the admin —
    // see ensureUserClient() in index.html). A self-registered Auth account
    // with no matching profile here simply can't do anything in the app.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      // Users may update their own profile (name/country/mustChangePassword)
      // but never their own role. Admins may update any field on any profile
      // (e.g. reassigning teamId when adding an existing person to a team).
      allow update: if isSignedIn() && (
        (isSelf(uid) && request.resource.data.role == resource.data.role)
        || isAdmin()
      );
      // Only an admin, and only pre-launch by app-level convention (the
      // Admin tab's roster tools refuse once the challenge has started) —
      // this is what lets re-keying the roster wipe and recreate participant
      // accounts cleanly during setup, before there's any real data at stake.
      allow delete: if isAdmin();
    }

    // Teams are provisioned the same way as users (see above) — only an admin
    // may create one. Once created, any signed-in participant may update a
    // team (leave/remove-member touch the team doc) without a backend.
    // Deleting is only ever allowed once a team is already empty (the app
    // clears `members` to [] right before deleting it when the last person
    // leaves) — this stops anyone from deleting an active team full of people.
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.members.size() == 0;
    }

    // Bonus challenges are admin-authored and admin-awarded. Everyone can
    // read them (needed to show what's on offer), and admins can write
    // anything — but a participant may also update the doc themselves, ONLY
    // to touch the `submissions` map (a timestamp per person/team who's
    // uploaded proof), so they can record their own submission without an
    // admin having to do it for them. (This trusts any signed-in user not to
    // tamper with someone else's submission entry — the same trust level
    // teams/{teamId} already gives any signed-in participant.) The `reviews`
    // map (an admin's verified/rejected/needs_review verdict, same shape as
    // steps/{uid}'s `verified`) is deliberately NOT in that allowance, so it
    // can only ever be set by an admin — never a participant, even by
    // calling Firestore directly.
    match /bonus/{bonusId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submissions']));
    }

    // Bonus challenge proof photos, kept out of bonus/{bonusId} (loaded by
    // everyone) the same way proofs/{uid} is kept out of steps/{uid} — see
    // that collection's comment. Keyed by uid for an individual challenge or
    // by teamId for a team one; either the account it belongs to, any member
    // of the team it belongs to, or an admin may write it.
    match /bonusProofs/{id} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isSelf(id)
        || (isSignedIn() && exists(/databases/$(database)/documents/teams/$(id)));
      allow delete: if isAdmin();
    }

    // Per-user step logs, keyed by uid. Everyone can read (leaderboard/team
    // views need everyone's totals). The owner can write their own days/proof,
    // but the "verified" audit stamp can only ever be set by an admin — never
    // by the participant themselves, even by calling Firestore directly.
    match /steps/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid) && !('verified' in request.resource.data);
      allow update: if isAdmin()
        || (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']));
      // Admin-only, and only meaningful pre-launch (see users/{uid} above) —
      // wiped alongside a user's profile when the roster is re-keyed.
      allow delete: if isAdmin();
    }

    // Proof photos, kept in their own doc separate from steps/{uid} so that
    // collection stays small — the one that's bulk-fetched for the Admin
    // tab's per-week breakdown. Photos themselves are only ever fetched one
    // document at a time (a specific participant) or in bulk deliberately
    // (the admin proof gallery / ZIP export), never automatically for
    // everyone the way steps/{uid} totals used to be. Same read/write shape
    // as steps/{uid}: owner writes their own, admin can also write (matches
    // steps/{uid}'s admin-update path) and delete (roster re-key wipes).
    match /proofs/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      allow update: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin();
    }
  }
}
